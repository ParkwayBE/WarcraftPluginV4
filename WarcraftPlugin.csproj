<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RootNamespace>WarcraftPlugin</RootNamespace>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Warcraft CounterstrikeSharp Plugin</Title>
    <Authors>WnGui</Authors>
    <Description>An open-source Warcraft mod for CS2 featuring a fully-fledged RPG system</Description>
    <RepositoryUrl>https://github.com/Wngui/CS2WarcraftMod</RepositoryUrl>
    <PackageIcon>wc-icon.png</PackageIcon>
    <PackageTags>warcraft;cs2;counterstrike;sharp</PackageTags>
    <PackageOutputPath>$(OutputPath)</PackageOutputPath>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.305" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="geometry3Sharp" Version="1.0.324" />
    <PackageReference Include="MIConvexHull" Version="1.1.19.1019" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="7.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10" />
    <PackageReference Include="SQLitePCLRaw.core" Version="2.1.10" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="lang\da.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="lang\ru.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="lang\en.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="CustomHeroes\ArchmageProudmoore.cs" />
    <None Include="CustomHeroes\Ben.cs" />
    <None Include="CustomHeroes\BloodMage.cs" />
    <None Include="CustomHeroes\Chameleon.cs" />
    <None Include="CustomHeroes\CryptLord.cs" />
    <None Include="CustomHeroes\DwarvenSniper.cs" />
    <None Include="CustomHeroes\HumanAlliance.cs" />
    <None Include="CustomHeroes\LaserLightShow.cs" />
    <None Include="CustomHeroes\Lukaku.cs" />
    <None Include="CustomHeroes\Naix.cs" />
    <None Include="CustomHeroes\NightElves.cs" />
    <None Include="CustomHeroes\OrcishHorde.cs" />
    <None Include="CustomHeroes\Pickachu.cs" />
    <None Include="CustomHeroes\Rapscallion.cs" />
    <None Include="CustomHeroes\ShadowHunter.cs" />
    <None Include="CustomHeroes\UndeadScourge.cs" />
    <None Include="CustomHeroes\Warden.cs" />
    <None Include="Resources\nuget\Readme.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="Resources\nuget\wc-icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="CustomHeroes\**" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="CustomHeroes\ArchmageProudmoore.cs" />
    <Compile Remove="CustomHeroes\Ben.cs" />
    <Compile Remove="CustomHeroes\BloodMage.cs" />
    <Compile Remove="CustomHeroes\Chameleon.cs" />
    <Compile Remove="CustomHeroes\CryptLord.cs" />
    <Compile Remove="CustomHeroes\DwarvenSniper.cs" />
    <Compile Remove="CustomHeroes\CustomSkillRace.cs" />
    <Compile Remove="CustomHeroes\HumanAlliance.cs" />
    <Compile Remove="CustomHeroes\LaserLightShow.cs" />
    <Compile Remove="CustomHeroes\Lukaku.cs" />
    <Compile Remove="CustomHeroes\Naix.cs" />
    <Compile Remove="CustomHeroes\NightElves.cs" />
    <Compile Remove="CustomHeroes\OrcishHorde.cs" />
    <Compile Remove="CustomHeroes\Pickachu.cs" />
    <Compile Remove="CustomHeroes\Rapscallion.cs" />
    <Compile Remove="CustomHeroes\ShadowHunter.cs" />
    <Compile Remove="CustomHeroes\UndeadScourge.cs" />
    <Compile Remove="CustomHeroes\Warden.cs" />
    <Compile Remove="CustomHeroes\Wraithstalker.cs" />
  </ItemGroup>
  </Project>